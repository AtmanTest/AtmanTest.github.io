{
  "name": "atmantest-site-build",
  "private": true,
  "description": "Construit assets/scene.js (scènes 3D) à partir de build/scene/main.js.",
  "scripts": {
    "build": "esbuild scene/main.js --bundle --format=esm --minify --target=es2020 --legal-comments=eof --outfile=../assets/scene.js"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "three": "0.169.0"
  }
}
